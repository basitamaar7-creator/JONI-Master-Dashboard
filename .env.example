# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_auth_domain
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_storage_bucket
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Google Cloud APIs
REACT_APP_GOOGLE_CLOUD_API_KEY=your_google_cloud_key
REACT_APP_GEMINI_API_KEY=your_gemini_key

# Social Media APIs
REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id
REACT_APP_INSTAGRAM_ACCESS_TOKEN=your_instagram_token
REACT_APP_YOUTUBE_API_KEY=your_youtube_key
REACT_APP_TIKTOK_CLIENT_KEY=your_tiktok_key
REACT_APP_WHATSAPP_TOKEN=your_whatsapp_token

# Joke API
REACT_APP_JOKE_API_URL=https://api.api-ninjas.com/v1/jokes
REACT_APP_JOKE_API_KEY=your_joke_api_key

# Environment
REACT_APP_ENV=development
